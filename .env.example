# Бэкенд хранилища: sqlite | supabase | api
STORAGE_BACKEND=api

# SQLite
DB_PATH=family_todo.db

# Клиент-сервер (используется при STORAGE_BACKEND=api)
API_URL=http://127.0.0.1:8000

# Supabase (используется при STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# API-сервер (server.py)
HOST=0.0.0.0
PORT=8000
